# ==============================================================================
# CampusSphere Environment Configuration Template
# ==============================================================================
# Copy this file to .env or set these environment variables in your deployment / IDE.
# DO NOT commit real secrets or API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Upscrape API Integration (Internshala Aggregation)
# ------------------------------------------------------------------------------
# Obtain your API key from https://app.upscrape.com/
# New accounts receive up to 100 free trial credits (valid 60 days, no card required).
# Each successful aggregation request consumes 1 credit. Failed requests are free.
UPSCRAPE_API_KEY=your_upscrape_api_key

# Upscrape API Base URL and Connection Settings (Optional overrides)
UPSCRAPE_BASE_URL=https://data.upscrape.com
UPSCRAPE_CONNECT_TIMEOUT_MS=5000
UPSCRAPE_READ_TIMEOUT_MS=35000
UPSCRAPE_WAIT_SECONDS=30

# Internshala Daily Aggregator Schedule & Filter Controls
INTERNSHALA_SYNC_ENABLED=true
INTERNSHALA_SYNC_CRON=0 0 2 * * ?
INTERNSHALA_SYNC_LIMIT=15
INTERNSHALA_SYNC_KEYWORDS=computer science,software engineering,web development

# ------------------------------------------------------------------------------
# 2. Database Connection (MySQL)
# ------------------------------------------------------------------------------
# Defaults to H2 in-memory when not running with the mysql profile.
MYSQL_URL=jdbc:mysql://localhost:3306/campushub?useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_mysql_password
# ------------------------------------------------------------------------------
# 3. Cloudinary File & Resume Storage
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

JWT_SECRET=replace_with_a_secure_random_secret
